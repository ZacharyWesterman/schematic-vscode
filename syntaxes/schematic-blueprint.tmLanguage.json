{
	"name": "Schematic Blueprint",
	"patterns": [
		{
			"include": "#comment"
		},
		{
			"include": "#operator"
		},
		{
			"include": "#number"
		},
		{
			"include": "#color"
		},
		{
			"include": "#boolean"
		},
		{
			"include": "#field"
		},
		{
			"include": "#node"
		},
		{
			"include": "#assignment"
		},
		{
			"include": "#type"
		},
		{
			"include": "#identifier"
		},
		{
			"include": "#string"
		}
	],
	"repository": {
		"comment": {
			"patterns": [
				{
					"name": "comment.single-line.schematic-blueprint",
					"match": "//.*"
				},
				{
					"name": "comment.multi-line.schematic-blueprint",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"operator": {
			"name": "keyword.schematic-blueprint",
			"match": "->|[|,.=]"
		},
		"number": {
			"name": "constant.numeric.schematic-blueprint",
			"match": "-?(\\.[0-9_]+\\b|\\b(0x[0-9a-fA-F_]+|0c[0-7]+|0b[01]+|[0-9][0-9_]*(\\.[0-9_]+)?)\\b)"
		},
		"color": {
			"name": "constant.color.schematic-node",
			"match": "#[a-fA-F0-9]*"
		},
		"boolean": {
			"name": "constant.language.schematic-node",
			"match": "\\b(true|false)\\b"
		},
		"identifier": {
			"name": "meta.variable.schematic-blueprint",
			"match": "[a-zA-Z_][a-zA-Z_0-9]*"
		},
		"type": {
			"name": "support.class.schematic-blueprint",
			"match": "(?<==)\\s*[a-zA-Z_][a-zA-Z_0-9]*(?!\\w)(?!\\s*[(=\"])"
		},
		"node": {
			"name": "entity.name.function.schematic-blueprint",
			"match": "[a-zA-Z_][a-zA-Z_0-9]*(?=\\s*[(\"])"
		},
		"assignment": {
			"name": "variable.schematic-blueprint",
			"match": "[a-zA-Z_][a-zA-Z_0-9]*(?=\\s*=)"
		},
		"field": {
			"name": "variable.schematic-blueprint",
			"match": "(?<=\\.)\\s*[a-zA-Z_][a-zA-Z_0-9]*"
		},
		"string": {
			"name": "string.quoted.schematic-blueprint",
			"begin": "\"",
			"end": "\""
		}
	},
	"scopeName": "source.schematic-blueprint"
}