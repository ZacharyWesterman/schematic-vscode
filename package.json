{
  "name": "schematic",
  "displayName": "Schematic Syntax",
  "description": "Syntax highlighting for the various Schematic syntaxes.",
  "version": "1.0.0",
  "license": "GPL-3",
  "publisher": "skrunk",
  "engines": {
    "vscode": "^1.134.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZacharyWesterman/schematic-vscode.git"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "schematic-node",
      "aliases": ["Schematic Node", "schematic-node"],
      "extensions": [".node"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "schematic-node",
      "scopeName": "source.schematic-node",
      "path": "./syntaxes/schematic-node.tmLanguage.json"
    }]
  }
}
